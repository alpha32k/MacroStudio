<Project>
  <!-- Shared build settings for every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Version>1.0.5</Version>
    <!-- Keep Windows upgrade and file versions above the previously released 1.1.3. -->
    <WindowsInstallerVersion>1.1.4</WindowsInstallerVersion>
    <FileVersion>$(WindowsInstallerVersion).0</FileVersion>
    <Product>Macro Studio</Product>
    <Authors>Ahmet Şahin</Authors>
    <Copyright>Copyright (c) 2026 Ahmet Şahin</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
