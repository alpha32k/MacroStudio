<Window x:Class="MacroStudio.App.Recording.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Macro Studio"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
  <!-- Shown before a recording or a playback starts; it never takes the focus and clicks go through it. -->
  <Border Padding="32,20"
          CornerRadius="16"
          BorderThickness="1"
          Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
    <StackPanel>
      <ui:SymbolIcon HorizontalAlignment="Center"
                     FontSize="28"
                     Symbol="Record24"
                     Filled="True"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
      <TextBlock x:Name="SecondsText"
                 HorizontalAlignment="Center"
                 FontSize="64"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <TextBlock x:Name="TitleText"
                 HorizontalAlignment="Center"
                 FontSize="16"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
      <TextBlock x:Name="HintText"
                 MaxWidth="280"
                 Margin="0,6,0,0"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Style="{StaticResource DescriptionTextStyle}" />
    </StackPanel>
  </Border>
</Window>
