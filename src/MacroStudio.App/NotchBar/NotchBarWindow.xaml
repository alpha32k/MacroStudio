<Window x:Class="MacroStudio.App.NotchBar.NotchBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:l="clr-namespace:MacroStudio.App.Localization"
        xmlns:local="clr-namespace:MacroStudio.App.NotchBar"
        Title="Macro Studio"
        Width="640"
        Height="48"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        FontSize="12">

  <Window.Resources>
    <Style x:Key="BarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Appearance" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <!-- Icon-only: screen readers read the tooltip text as the name. -->
      <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="BarSeparatorStyle" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Fill" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="BarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>

    <Style x:Key="BarLabelIconStyle" TargetType="ui:SymbolIcon">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Margin" Value="8,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
  </Window.Resources>

  <Grid>
    <local:NotchShape x:Name="NotchOutline"
                      Width="160"
                      Height="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Fill="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                      Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                      StrokeThickness="1" />

    <!-- Small line on the closed bar: grey when idle, pulsing red while recording, pulsing accent while
         playing, steady yellow while paused. The pulses run only when needed; an endless animation would
         redraw the bar all day. -->
    <Grid x:Name="StateIndicator"
          Margin="0,2,0,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          IsHitTestVisible="False">
      <Rectangle Width="44" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
      <Rectangle Width="44" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource SystemFillColorCriticalBrush}">
        <Rectangle.Style>
          <Style TargetType="Rectangle">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsRecording}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                  <BeginStoryboard x:Name="RecordingPulse">
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="RecordingPulse" />
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Rectangle.Style>
      </Rectangle>
      <Rectangle Width="44" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource AccentFillColorDefaultBrush}">
        <Rectangle.Style>
          <Style TargetType="Rectangle">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPlaybackRunning}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
                <DataTrigger.EnterActions>
                  <BeginStoryboard x:Name="PlaybackPulse">
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
                    </Storyboard>
                  </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="PlaybackPulse" />
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Rectangle.Style>
      </Rectangle>
      <Rectangle Width="44"
                 Height="2"
                 RadiusX="1"
                 RadiusY="1"
                 Fill="{DynamicResource SystemFillColorCautionBrush}"
                 Visibility="{Binding IsPlaybackPaused, Converter={StaticResource BooleanToVisibility}}" />
    </Grid>

    <StackPanel x:Name="BarContent"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                IsHitTestVisible="False">
      <ui:Button Style="{StaticResource BarButtonStyle}"
                 Icon="{ui:SymbolIcon Home20}"
                 ToolTip="{l:Loc Bar_Home}"
                 Command="{Binding OpenMainWindowCommand}" />

      <Rectangle Style="{StaticResource BarSeparatorStyle}" />

      <ui:Button Style="{StaticResource BarButtonStyle}" ToolTip="{l:Loc Bar_Record}" Command="{Binding StartRecordingCommand}">
        <ui:Button.Icon>
          <ui:SymbolIcon Symbol="Record20" Filled="True" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </ui:Button.Icon>
      </ui:Button>
      <!-- Play; Pause while a macro plays; Resume while paused. -->
      <ui:Button Command="{Binding PlayPauseCommand}">
        <ui:Button.Style>
          <Style TargetType="ui:Button" BasedOn="{StaticResource BarButtonStyle}">
            <Setter Property="ToolTip" Value="{l:Loc Bar_Play}" />
            <Setter Property="Icon" Value="{ui:SymbolIcon Play20}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPlaybackRunning}" Value="True">
                <Setter Property="ToolTip" Value="{l:Loc Bar_Pause}" />
                <Setter Property="Icon" Value="{ui:SymbolIcon Pause20}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsPlaybackPaused}" Value="True">
                <Setter Property="ToolTip" Value="{l:Loc Bar_Resume}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:Button.Style>
      </ui:Button>
      <ui:Button Style="{StaticResource BarButtonStyle}" Icon="{ui:SymbolIcon Stop20}" ToolTip="{l:Loc Bar_Stop}" Command="{Binding StopCommand}" />

      <Rectangle Style="{StaticResource BarSeparatorStyle}" />

      <ComboBox x:Name="MacroBox"
                Style="{StaticResource BarComboBoxStyle}"
                Width="120"
                ToolTip="{l:Loc Bar_Macro}"
                Visibility="{Binding HasMacros, Converter={StaticResource BooleanToVisibility}}"
                IsEnabled="{Binding CanChooseMacro}"
                ItemsSource="{Binding Macros}"
                SelectedItem="{Binding SelectedMacro}"
                DisplayMemberPath="Macro.Name" />
      <ComboBox Width="120" ToolTip="{l:Loc Bar_Macro}" IsEnabled="False" SelectedIndex="0">
        <ComboBox.Style>
          <Style TargetType="ComboBox" BasedOn="{StaticResource BarComboBoxStyle}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasMacros}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ComboBox.Style>
        <ComboBoxItem Content="{l:Loc Bar_NoMacros}" />
      </ComboBox>

      <!-- Repeat and speed are chosen before playing; while a macro plays its progress takes their place. -->
      <StackPanel Orientation="Horizontal">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPlaybackActive}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <ui:SymbolIcon Style="{StaticResource BarLabelIconStyle}" Symbol="ArrowRepeatAll20" />
        <ComboBox x:Name="LoopBox"
                  Style="{StaticResource BarComboBoxStyle}"
                  Width="116"
                  ToolTip="{l:Loc Bar_Loop}"
                  IsEnabled="{Binding CanChooseMacro}"
                  ItemsSource="{Binding LoopChoices}"
                  SelectedItem="{Binding SelectedLoop}"
                  DisplayMemberPath="Label" />

        <ui:SymbolIcon Style="{StaticResource BarLabelIconStyle}" Symbol="TopSpeed20" />
        <ComboBox x:Name="SpeedBox"
                  Style="{StaticResource BarComboBoxStyle}"
                  Width="72"
                  ToolTip="{l:Loc Bar_Speed}"
                  IsEnabled="{Binding CanChooseMacro}"
                  ItemsSource="{Binding SpeedChoices}"
                  SelectedItem="{Binding SelectedSpeed}"
                  ItemStringFormat="{}{0:0.##}x" />
      </StackPanel>

      <TextBlock Width="200"
                 Margin="10,0,0,0"
                 VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Text="{Binding StatusText}"
                 Visibility="{Binding IsPlaybackActive, Converter={StaticResource BooleanToVisibility}}" />

      <Rectangle Style="{StaticResource BarSeparatorStyle}" />

      <!-- Pin: keeps the bar open even when the pointer leaves it. -->
      <ui:Button Command="{Binding TogglePinCommand}">
        <ui:Button.Style>
          <Style TargetType="ui:Button" BasedOn="{StaticResource BarButtonStyle}">
            <Setter Property="ToolTip" Value="{l:Loc Bar_Pin}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter Property="ToolTip" Value="{l:Loc Bar_Unpin}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:Button.Style>
        <ui:Button.Icon>
          <ui:SymbolIcon Symbol="Pin20">
            <ui:SymbolIcon.Style>
              <Style TargetType="ui:SymbolIcon">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Filled" Value="True" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ui:SymbolIcon.Style>
          </ui:SymbolIcon>
        </ui:Button.Icon>
      </ui:Button>
    </StackPanel>
  </Grid>
</Window>
