<ui:FluentWindow x:Class="MacroStudio.App.Macros.SaveMacroWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:MacroStudio.App.Localization"
                 Title="{Binding Title, Mode=OneTime}"
                 Icon="pack://application:,,,/Assets/MacroStudio.ico"
                 Width="620"
                 Height="660"
                 MinWidth="480"
                 MinHeight="440"
                 Topmost="True"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{Binding Title, Mode=OneTime}" ShowMaximize="False" ShowMinimize="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/MacroStudio.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <StackPanel Grid.Row="1" Margin="24,8,24,0">
      <!-- An imported macro was made by someone else: the user checks what it does before it ever runs. -->
      <TextBlock Margin="0,0,0,12"
                 Style="{StaticResource BodyTextStyle}"
                 Text="{l:Loc Import_Notice}"
                 Visibility="{Binding IsImport, Converter={StaticResource BooleanToVisibility}}" />
      <TextBlock Margin="0,0,0,6" Style="{StaticResource BodyTextStyle}" Text="{l:Loc Save_Name}" />
      <ui:TextBox x:Name="NameBox" AutomationProperties.Name="{l:Loc Save_Name}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,8,0,0" Style="{StaticResource DescriptionTextStyle}" Text="{Binding StepCountText, Mode=OneTime}" />
    </StackPanel>

    <!-- Shown when the macro scrolls Excel with the mouse wheel. -->
    <StackPanel Grid.Row="2" Margin="24,12,24,0" Visibility="{Binding HasExcelWheel, Converter={StaticResource BooleanToVisibility}}">
      <Border Padding="16,12"
              CornerRadius="6"
              BorderThickness="1"
              Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Warning24" Filled="True" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}" Text="{l:Loc Save_ExcelWheelTitle}" />
          </StackPanel>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource BodyTextStyle}" Text="{Binding ExcelWheelMessage}" />
          <ui:Button Margin="0,10,0,0"
                     Icon="{ui:SymbolIcon ArrowDown24}"
                     Content="{l:Loc Save_ConvertWheel}"
                     Command="{Binding ConvertWheelCommand}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <ListBox Grid.Row="3" Margin="24,12,24,0" ItemsSource="{Binding Rows}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource DescriptionTextStyle}" Text="{Binding Number}" />
            <ui:SymbolIcon Grid.Column="1" FontSize="16" HorizontalAlignment="Left" Symbol="{Binding Icon}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Description}" />
            <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource DescriptionTextStyle}" Text="{Binding DelayBeforeMs, StringFormat={}{0} ms}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="4" Margin="24,16" HorizontalAlignment="Right" Orientation="Horizontal">
      <ui:Button Margin="0,0,8,0" Content="{Binding CancelText, Mode=OneTime}" Click="OnCancelClick" />
      <ui:Button Appearance="Primary" IsDefault="True" Icon="{ui:SymbolIcon Save24}" Content="{Binding SaveText, Mode=OneTime}" Command="{Binding SaveCommand}" />
    </StackPanel>
  </Grid>
</ui:FluentWindow>
