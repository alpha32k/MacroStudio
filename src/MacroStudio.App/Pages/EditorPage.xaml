<pages:ContentPage x:Class="MacroStudio.App.Pages.EditorPage"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:l="clr-namespace:MacroStudio.App.Localization"
                   xmlns:pages="clr-namespace:MacroStudio.App.Pages"
                   xmlns:macros="clr-namespace:MacroStudio.Core.Macros;assembly=MacroStudio.Core"
                   ScrollViewer.CanContentScroll="False">
  <!-- CanContentScroll="False": the step table scrolls by itself, so WPF UI leaves out its page scroll viewer. -->
  <pages:ContentPage.InputBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+D" Command="{Binding DuplicateSelectedCommand}" />
    <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
    <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
  </pages:ContentPage.InputBindings>

  <pages:ContentPage.Resources>
    <Style x:Key="ToolButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <!-- Icon-only buttons: screen readers read the tooltip text as the name. -->
      <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="ToolSeparatorStyle" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="4,4,8,8" />
      <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="ColumnHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource DescriptionTextStyle}">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
  </pages:ContentPage.Resources>

  <Grid Margin="32,8,32,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Style="{StaticResource PageTitleStyle}" Text="{l:Loc Nav_Editor}" />

    <!-- No macro to edit yet. -->
    <ui:Card Grid.Row="1" Padding="24" VerticalAlignment="Top">
      <ui:Card.Style>
        <Style TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ui:Card.Style>
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Symbol="DocumentEdit24" FontSize="32" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Style="{StaticResource BodyTextStyle}" Margin="16,0,0,0" VerticalAlignment="Center" Text="{l:Loc Editor_Empty}" />
      </StackPanel>
    </ui:Card>

    <!-- The macro: which one, its name, repeat and speed. -->
    <WrapPanel Grid.Row="1" Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <StackPanel Margin="0,0,12,8">
        <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,4" Text="{l:Loc Editor_Macro}" />
        <ComboBox Width="220" AutomationProperties.Name="{l:Loc Editor_Macro}" ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" DisplayMemberPath="Macro.Name" />
      </StackPanel>
      <StackPanel Margin="0,0,12,8">
        <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,4" Text="{l:Loc Save_Name}" />
        <ui:TextBox Width="220" AutomationProperties.Name="{l:Loc Save_Name}" MaxLength="{x:Static macros:MacroValidator.MaxNameLength}" ClearButtonEnabled="False" Text="{Binding MacroName, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Margin="0,0,12,8">
        <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,4" Text="{l:Loc Editor_Description}" />
        <ui:TextBox Width="260" AutomationProperties.Name="{l:Loc Editor_Description}" MaxLength="{x:Static macros:MacroValidator.MaxDescriptionLength}" ClearButtonEnabled="False" Text="{Binding MacroDescription, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Margin="0,0,12,8">
        <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,4" Text="{l:Loc Bar_Loop}" />
        <ComboBox Width="140" AutomationProperties.Name="{l:Loc Bar_Loop}" ItemsSource="{Binding LoopChoices}" SelectedItem="{Binding SelectedLoop}" DisplayMemberPath="Label" />
      </StackPanel>
      <StackPanel Margin="0,0,12,8">
        <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,4" Text="{l:Loc Bar_Speed}" />
        <ComboBox Width="90" AutomationProperties.Name="{l:Loc Bar_Speed}" ItemsSource="{Binding SpeedChoices}" SelectedItem="{Binding SelectedSpeed}" ItemStringFormat="{}{0:0.##}x" />
      </StackPanel>
      <StackPanel Margin="0,0,0,8" VerticalAlignment="Bottom" Orientation="Horizontal">
        <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="{l:Loc Save_Save}" ToolTip="Ctrl+S" Command="{Binding SaveCommand}" />
        <TextBlock Style="{StaticResource DescriptionTextStyle}"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"
                   Text="{l:Loc Editor_Unsaved}"
                   Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibility}}" />
      </StackPanel>
    </WrapPanel>

    <Grid Grid.Row="2" Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ui:InfoBar Margin="0,0,0,8" Severity="Warning" IsOpen="True" IsClosable="False" Message="{Binding ScreenWarning}">
        <ui:InfoBar.Style>
          <Style TargetType="ui:InfoBar" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ScreenWarning}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ui:InfoBar.Style>
      </ui:InfoBar>

      <!-- Tools for the selected steps. -->
      <WrapPanel Grid.Row="1" Margin="0,0,0,4">
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon ArrowUndo24}" ToolTip="{l:Loc Editor_Undo}" Command="{Binding UndoCommand}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon ArrowRedo24}" ToolTip="{l:Loc Editor_Redo}" Command="{Binding RedoCommand}" />
        <Border Style="{StaticResource ToolSeparatorStyle}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon Delete24}" ToolTip="{l:Loc Editor_Delete}" Command="{Binding DeleteSelectedCommand}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon Copy24}" ToolTip="{l:Loc Editor_Duplicate}" Command="{Binding DuplicateSelectedCommand}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon ArrowUp24}" ToolTip="{l:Loc Editor_MoveUp}" Command="{Binding MoveUpCommand}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon ArrowDown24}" ToolTip="{l:Loc Editor_MoveDown}" Command="{Binding MoveDownCommand}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon CheckboxChecked24}" ToolTip="{l:Loc Editor_ToggleEnabled}" Command="{Binding ToggleEnabledCommand}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon Timer24}" ToolTip="{l:Loc Editor_SetDelay}" Command="{Binding SetDelayOfSelectedCommand}" />
        <Border Style="{StaticResource ToolSeparatorStyle}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon Add24}" Content="{l:Loc Editor_AddStep}" Click="OnMenuButtonClick">
          <ui:Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{l:Loc Insert_Wait}" Icon="{ui:SymbolIcon Timer20}" Command="{Binding InsertWaitCommand}" />
              <MenuItem Header="{l:Loc Insert_Key}" Icon="{ui:SymbolIcon Keyboard20}" Command="{Binding InsertKeyCommand}" />
              <MenuItem Header="{l:Loc Insert_Text}" Icon="{ui:SymbolIcon TextT20}" Command="{Binding InsertTextCommand}" />
              <MenuItem Header="{l:Loc Insert_Copy}" Icon="{ui:SymbolIcon Copy20}" Command="{Binding InsertCopyCommand}" />
              <MenuItem Header="{l:Loc Insert_Paste}" Icon="{ui:SymbolIcon ClipboardPaste20}" Command="{Binding InsertPasteCommand}" />
              <MenuItem Header="{l:Loc Insert_FocusWindow}" Icon="{ui:SymbolIcon Window20}" Command="{Binding InsertFocusWindowCommand}" />
              <MenuItem Header="{l:Loc Insert_Click}" Icon="{ui:SymbolIcon CursorClick20}" Command="{Binding InsertClickCommand}" />
            </ContextMenu>
          </ui:Button.ContextMenu>
        </ui:Button>
        <Border Style="{StaticResource ToolSeparatorStyle}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon Play24}" Content="{l:Loc Editor_PlayFromHere}" Command="{Binding PlayFromHereCommand}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon ArrowStepIn24}" Content="{l:Loc Editor_TryStep}" Command="{Binding TryStepCommand}" />
        <ui:Button Style="{StaticResource ToolButtonStyle}" Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="{l:Loc Editor_More}" Click="OnMenuButtonClick">
          <ui:Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{l:Loc Editor_RestorePrevious}" Icon="{ui:SymbolIcon History20}" Command="{Binding RestorePreviousVersionCommand}" />
              <MenuItem Header="{l:Loc Editor_ConvertExcelWheel}" Icon="{ui:SymbolIcon ArrowSort20}" Command="{Binding ConvertExcelWheelCommand}" />
            </ContextMenu>
          </ui:Button.ContextMenu>
        </ui:Button>
      </WrapPanel>

      <!-- Column header; widths match the line template below. -->
      <Grid Grid.Row="2" Margin="4,0,4,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40" />
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="104" />
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource ColumnHeaderStyle}" Text="#" />
        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderStyle}" Text="{l:Loc Editor_ColumnEnabled}" />
        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderStyle}" Text="{l:Loc Editor_ColumnStep}" />
        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderStyle}" Text="{l:Loc Editor_ColumnDelay}" />
        <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeaderStyle}" Text="{l:Loc Editor_ColumnNote}" />
      </Grid>

      <ui:ListView x:Name="StepList"
                Grid.Row="3"
                ItemsSource="{Binding Rows}"
                SelectionMode="Extended"
                HorizontalContentAlignment="Stretch"
                AllowDrop="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                SelectionChanged="OnSelectionChanged"
                PreviewGotKeyboardFocus="OnListFocusChanging"
                PreviewMouseLeftButtonDown="OnListMouseDown"
                PreviewMouseMove="OnListMouseMove"
                DragOver="OnListDragOver"
                Drop="OnListDrop">
        <ui:ListView.InputBindings>
          <!-- Here, not on the page, so Delete in a text box still deletes text. -->
          <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" />
        </ui:ListView.InputBindings>
        <ui:ListView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{l:Loc Editor_PlayFromHere}" Icon="{ui:SymbolIcon Play20}" Command="{Binding PlayFromHereCommand}" />
            <MenuItem Header="{l:Loc Editor_TryStep}" Icon="{ui:SymbolIcon ArrowStepIn20}" Command="{Binding TryStepCommand}" />
            <Separator />
            <MenuItem Header="{l:Loc Editor_Duplicate}" Icon="{ui:SymbolIcon Copy20}" Command="{Binding DuplicateSelectedCommand}" />
            <MenuItem Header="{l:Loc Editor_ToggleEnabled}" Icon="{ui:SymbolIcon CheckboxChecked20}" Command="{Binding ToggleEnabledCommand}" />
            <MenuItem Header="{l:Loc Editor_SetDelay}" Icon="{ui:SymbolIcon Timer20}" Command="{Binding SetDelayOfSelectedCommand}" />
            <Separator />
            <MenuItem Header="{l:Loc Editor_Delete}" Icon="{ui:SymbolIcon Delete20}" Command="{Binding DeleteSelectedCommand}" />
          </ContextMenu>
        </ui:ListView.ContextMenu>
        <ui:ListView.ItemTemplate>
          <DataTemplate DataType="{x:Type pages:EditorRow}">
            <Grid>
              <Grid.Style>
                <!-- Disabled steps stay in the list, faded; they are skipped when the macro plays. -->
                <Style TargetType="Grid">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                      <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="104" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="32" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource DescriptionTextStyle}" VerticalAlignment="Center" Text="{Binding Number}" />
              <CheckBox Grid.Column="1" MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" ToolTip="{l:Loc Editor_ToggleEnabled}" AutomationProperties.Name="{l:Loc Editor_ColumnEnabled}" />
              <ui:SymbolIcon Grid.Column="2" FontSize="18" VerticalAlignment="Center" Symbol="{Binding Icon}" />
              <TextBlock Grid.Column="3"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         FontSize="14"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding Description}"
                         ToolTip="{Binding Description}" />
              <TextBox Grid.Column="4"
                       Margin="0,2,8,2"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Text="{Binding DelayText, UpdateSourceTrigger=LostFocus}"
                       AutomationProperties.Name="{l:Loc Editor_ColumnDelay}"
                       ToolTip="{l:Loc Editor_DelayPrompt}" />
              <ui:TextBox Grid.Column="5"
                          Margin="0,2,0,2"
                          VerticalAlignment="Center"
                          ClearButtonEnabled="False"
                          PlaceholderText="{l:Loc Editor_NotePlaceholder}"
                          AutomationProperties.Name="{l:Loc Editor_ColumnNote}"
                          Text="{Binding Note, UpdateSourceTrigger=LostFocus}" />
              <ui:SymbolIcon Grid.Column="6"
                             FontSize="18"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Symbol="Warning24"
                             Foreground="{DynamicResource SystemFillColorCautionBrush}"
                             ToolTip="{Binding Warning}">
                <ui:SymbolIcon.Style>
                  <Style TargetType="ui:SymbolIcon">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Warning}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ui:SymbolIcon.Style>
              </ui:SymbolIcon>
            </Grid>
          </DataTemplate>
        </ui:ListView.ItemTemplate>
      </ui:ListView>

      <TextBlock Grid.Row="4" Style="{StaticResource DescriptionTextStyle}" Margin="0,8,0,0" Text="{l:Loc Editor_Hint}" />
    </Grid>
  </Grid>
</pages:ContentPage>
