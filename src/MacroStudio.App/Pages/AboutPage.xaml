<pages:ContentPage x:Class="MacroStudio.App.Pages.AboutPage"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:l="clr-namespace:MacroStudio.App.Localization"
                   xmlns:pages="clr-namespace:MacroStudio.App.Pages">
  <StackPanel Style="{StaticResource PageContentStyle}">
    <TextBlock Style="{StaticResource PageTitleStyle}" Text="{l:Loc Nav_About}" />

    <ui:Card Padding="24">
      <StackPanel Orientation="Horizontal">
        <Image Width="64" Height="64" Source="pack://application:,,,/Assets/MacroStudio.ico" />
        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{l:Loc App_Name}" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Style="{StaticResource DescriptionTextStyle}" Text="{l:Loc About_Version}" />
            <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="4,0,0,0" Text="{Binding Version, Mode=OneTime}" />
          </StackPanel>
          <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0" Text="{l:Loc About_Description}" />
          <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="0,4,0,0" Text="{l:Loc About_License}" />
          <ui:HyperlinkButton Style="{StaticResource SignatureStyle}" Margin="-4,8,0,0" HorizontalAlignment="Left" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </ui:Card>

    <ui:Button Margin="0,12,0,0" Icon="{ui:SymbolIcon FolderOpen24}" Content="{l:Loc About_OpenLogs}" Command="{Binding OpenLogFolderCommand}" />

    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="{l:Loc About_ThirdParty}" />
    <ItemsControl ItemsSource="{Binding Components, Mode=OneTime}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <ui:HyperlinkButton Padding="4,2" Content="{Binding Name}" NavigateUri="{Binding Website}" />
            <TextBlock Style="{StaticResource DescriptionTextStyle}" Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding License}" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</pages:ContentPage>
