<ui:FluentWindow x:Class="MacroStudio.App.Shell.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:MacroStudio.App.Localization"
                 xmlns:pages="clr-namespace:MacroStudio.App.Pages"
                 Title="{l:Loc App_Name}"
                 Icon="pack://application:,,,/Assets/MacroStudio.ico"
                 Width="1000"
                 Height="680"
                 MinWidth="720"
                 MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="{l:Loc App_Name}" ShowMaximize="True" ShowMinimize="True">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/MacroStudio.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <ui:NavigationView x:Name="Navigation"
                       Grid.Row="1"
                       PaneDisplayMode="Left"
                       OpenPaneLength="220"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="True">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="{l:Loc Nav_Home}" Icon="{ui:SymbolIcon Home24}" TargetPageType="{x:Type pages:HomePage}" />
        <ui:NavigationViewItem Content="{l:Loc Nav_Macros}" Icon="{ui:SymbolIcon Library24}" TargetPageType="{x:Type pages:MacrosPage}" />
        <ui:NavigationViewItem Content="{l:Loc Nav_Editor}" Icon="{ui:SymbolIcon DocumentEdit24}" TargetPageType="{x:Type pages:EditorPage}" />
      </ui:NavigationView.MenuItems>
      <ui:NavigationView.PaneFooter>
        <ui:HyperlinkButton Style="{StaticResource SignatureStyle}" Margin="12,0,12,8" />
      </ui:NavigationView.PaneFooter>
      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Content="{l:Loc Nav_Settings}" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type pages:SettingsPage}" />
        <ui:NavigationViewItem Content="{l:Loc Nav_About}" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type pages:AboutPage}" />
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>
  </Grid>
</ui:FluentWindow>
